# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# ID of the channel the bot watches for music links (right-click channel -> Copy Channel ID).
# TikTok / Instagram Reel links are reposted as mp4s in every channel regardless.
CHANNEL_ID=123456789012345678

# Free Spotify app credentials from https://developer.spotify.com/dashboard
# (required to resolve Spotify links; without them Spotify shows NOT FOUND)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Optional: Netscape-format cookies file (exported from a logged-in browser)
# passed to yt-dlp. Instagram often refuses Reel downloads without one.
# VIDEO_COOKIES_FILE=cookies.txt

# Optional: Apple Music storefronts (country codes) to search, in order. The
# iTunes API only sees one country's catalog at a time, so Japan-only releases
# need "jp" in the list. Default: us,jp
# APPLE_MUSIC_STOREFRONTS=us,jp

# Optional: file a GitHub issue when someone reacts 👎 to a match (one issue
# per run, deduped by the run id in the embed footer). Use a fine-grained
# token with Issues: read & write on the repo below.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=zozzelmus/clanky-cat
